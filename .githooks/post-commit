#!/usr/bin/env sh
# Runs only after local opt-in; Git never installs versioned hooks on clone.
set -u
if [ "$(git config --local --get firstclass.mirror.enabled 2>/dev/null || true)" != "true" ]; then
  exit 0
fi
if [ "\${FIRSTCLASS_MIRROR_IN_PROGRESS:-}" = "1" ]; then
  exit 0
fi
source_root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [ -z "$source_root" ] || [ ! -f "$source_root/scripts/sync-firstclass.sh" ]; then
  printf >&2 'firstclass mirror: sync script not found.\n'
  exit 0
fi
if FIRSTCLASS_MIRROR_IN_PROGRESS=1 bash "$source_root/scripts/sync-firstclass.sh" --push; then
  printf 'firstclass mirror: snapshot branch updated.\n'
else
  printf >&2 'firstclass mirror FAILED: source commit exists; retry with bash scripts/sync-firstclass.sh --push.\n'
fi
# Git post-commit fires after the source commit; mirror failures must be explicit.
exit 0
